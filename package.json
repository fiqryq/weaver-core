{
  "name": "weaver-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "check": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "build": "bun build src/main.ts --compile --outfile dist/weaver-server",
    "build:linux-x64": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/weaver-server-linux-x64",
    "build:linux-arm64": "bun build src/main.ts --compile --target=bun-linux-arm64 --outfile dist/weaver-server-linux-arm64"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.2",
    "@effect/platform-bun": "4.0.2",
    "@effect/sql-sqlite-bun": "4.0.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "effect": "4.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
